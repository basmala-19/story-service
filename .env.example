# --- S2 / Gemini section (merge into the project's .env.example) ---
LLM_PROVIDER=gemini
# Put your key here in .env (NOT in this file, NOT in chat, NOT in git).
GEMINI_API_KEY=
# Verify these ids in the Gemini docs before production (spec 14.2).
GEMINI_MODEL_LARGE=gemini-2.5-pro
GEMINI_MODEL_SMALL=gemini-2.5-flash
GEMINI_MODEL_VISION=gemini-2.5-pro
MAX_STAGE_ATTEMPTS=3
