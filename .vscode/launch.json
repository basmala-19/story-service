{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "S2 live smoke (book lesson, 3 runs)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/s2_live_smoke.py",
      "args": [
        "--intake", "tests/fixtures/golden/book_p4_u1_l2_intake.json",
        "--brief", "tests/fixtures/golden/brief.json",
        "--runs", "3", "--out", "out"
      ],
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
